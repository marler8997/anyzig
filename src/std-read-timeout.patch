+/// deviceIoControl's nonblocking path for an AFD receive, canceled when no data arrives for
+/// `timeout`, with its status set to IO_TIMEOUT.
+fn afdReceiveTimeout(socket_handle: net.Socket.Handle, in: []const u8, timeout: Io.Duration) Io.Cancelable!windows.IO_STATUS_BLOCK {
+    var iosb: windows.IO_STATUS_BLOCK = undefined;
+    var done: bool = false;
+    switch (windows.ntdll.NtDeviceIoControlFile(
+        socket_handle,
+        null, // event
+        flagApc,
+        &done, // APC context
+        &iosb,
+        windows.IOCTL.AFD.RECEIVE,
+        in.ptr,
+        @intCast(in.len),
+        null,
+        0,
+    )) {
+        .PENDING, .SUCCESS => {},
+        else => |status| {
+            iosb.u.Status = status;
+            return iosb;
+        },
+    }
+    const deadline = nowWindows(.awake).nanoseconds + timeout.nanoseconds;
+    while (!done) {
+        const remaining = deadline - nowWindows(.awake).nanoseconds;
+        if (remaining <= 0) {
+            var cancel_iosb: windows.IO_STATUS_BLOCK = undefined;
+            _ = windows.ntdll.NtCancelIoFileEx(socket_handle, &iosb, &cancel_iosb);
+            while (!done) waitForApcOrAlert();
+            if (iosb.u.Status == .CANCELLED) iosb.u.Status = .IO_TIMEOUT;
+            return iosb;
+        }
+        const alertable_syscall = AlertableSyscall.start() catch |err| switch (err) {
+            error.Canceled => |e| {
+                var cancel_iosb: windows.IO_STATUS_BLOCK = undefined;
+                _ = windows.ntdll.NtCancelIoFileEx(socket_handle, &iosb, &cancel_iosb);
+                while (!done) waitForApcOrAlert();
+                return e;
+            },
+        };
+        // negative is relative, in 100 ns units
+        const delay: windows.LARGE_INTEGER = -@as(windows.LARGE_INTEGER, @intCast(@divFloor(remaining + 99, 100)));
+        _ = windows.ntdll.NtDelayExecution(.TRUE, &delay);
+        alertable_syscall.finish();
+    }
+    return iosb;
+}
