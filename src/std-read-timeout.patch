+fn netWaitReadablePosix(fd: net.Socket.Handle, timeout: Io.Duration) net.Stream.Reader.Error!void {
+    const deadline = nowPosix(.awake).nanoseconds + timeout.nanoseconds;
+    var fds = [1]posix.pollfd{.{ .fd = fd, .events = posix.POLL.IN, .revents = 0 }};
+    const syscall: Syscall = try .start();
+    while (true) {
+        const remaining: Io.Duration = .{ .nanoseconds = @max(0, deadline - nowPosix(.awake).nanoseconds) };
+        // round up, so a remaining fraction of a millisecond doesn't become a busy loop
+        const ms: i32 = @intCast(@min(std.math.maxInt(i32), @divFloor(remaining.nanoseconds + std.time.ns_per_ms - 1, std.time.ns_per_ms)));
+        const rc = posix.system.poll(&fds, fds.len, ms);
+        switch (posix.errno(rc)) {
+            .SUCCESS => {
+                if (rc != 0) break;
+                if (nowPosix(.awake).nanoseconds >= deadline) {
+                    syscall.finish();
+                    return error.ConnectionTimedOut;
+                }
+            },
+            .INTR => try syscall.checkCancel(),
+            .NOMEM => {
+                syscall.finish();
+                return error.SystemResources;
+            },
+            else => |err| {
+                syscall.finish();
+                return posix.unexpectedErrno(err);
+            },
+        }
+    }
+    syscall.finish();
+}
